{
    "compilerOptions": {
        "baseUrl": ".",
        "module": "ESNext",
        "target": "ES2022",
        "moduleResolution": "bundler",
        "allowJs": false,
        "noImplicitAny": true,
        "strict": true,
        "strictNullChecks": true,
        "noUncheckedIndexedAccess": true,
        "noUnusedLocals": true,
        "importHelpers": false,
        "isolatedModules": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "lib": ["DOM", "ES2022"],
        "paths": {
            "@/*": ["src/*"]
        }
    },
    "include": ["src/**/*.ts"]
}
